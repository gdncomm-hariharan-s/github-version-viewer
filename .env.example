GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_ORG=gdncomm
PORT=3000

# Optional — enables "Update Jira CRF" on the release PR summary page
JIRA_URL=https://gdncomm.atlassian.net
JIRA_USER=you@gdn-commerce.com
JIRA_TOKEN=your-jira-api-token

# Optional — enables locking a (service, env) pair to block Deploy/Reset/Promote
DATABASE_URL=postgres://postgres:postgres@localhost:5432/github_version_viewer
